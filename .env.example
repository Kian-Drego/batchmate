# ---------------------------------------------------------------------------
# Server configuration
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/scholarship_passport

# Development convenience: when the Mongo URI is unreachable, start an
# in-memory MongoDB (mongodb-memory-server) so the app runs out of the box.
# Production never falls back to memory.
# USE_MEMORY_DB=true
# MONGOMS_SYSTEM_BINARY=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 credentials (optional - only needed to enable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---------------------------------------------------------------------------
# File storage. STORAGE_DRIVER = local | s3 | supabase
# The "local" driver writes to disk and serves files via the API, which keeps
# development dependency-free. s3/supabase issue presigned upload URLs.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads

AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=scholarship-documents

# ---------------------------------------------------------------------------
# AI exam generation. AI_PROVIDER = openai-compatible | huggingface | disabled
# Any OpenAI-compatible endpoint works: Groq, Ollama, vLLM, Together, etc.
# ---------------------------------------------------------------------------
AI_PROVIDER=disabled
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
HUGGINGFACE_API_KEY=

# ---------------------------------------------------------------------------
# Scraper
# ---------------------------------------------------------------------------
# When true the scraper performs live Playwright/Cheerio fetches.
# When false it ingests the bundled verified snapshot (safe offline default).
SCRAPER_LIVE=false
SCRAPER_MAX_PAGES=5

# ---------------------------------------------------------------------------
# Client (build-time; bundled into the browser app)
# ---------------------------------------------------------------------------
# Absolute URL of the API origin for production builds, no trailing slash.
# Leave blank to call the API on the same origin (Vite dev proxy or a
# single-host deployment). For a split deployment such as GitHub Pages +
# Render, set this to the API URL, e.g. https://batchmate-api.onrender.com
VITE_API_URL=
